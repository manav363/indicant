# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Data & cache (never commit raw data)
#
# ANCHORED with a leading slash. Unanchored, `data/` matches a directory of
# that name at ANY depth — and it silently excluded
# services/intelligence/src/intelligence/data/, which holds lake_client.py,
# preprocessor.py and its __init__. Those are imported by serving.py, train.py,
# cli.py, panel/builder.py and api/main.py, so the published repository could
# not run the intelligence service at all. git status stayed clean the whole
# time, because ignored files are not untracked files.
/data/
*.parquet
*.csv
*.h5
*.pkl
*.joblib
# Test fixtures ARE committed — they are small, hand-built, and load-bearing
!**/tests/fixtures/**/*.csv
!**/tests/fixtures/**/*.parquet

# Environment
.env
.env.*
!.env.example

# ML artifacts
*.model
*.xgb
mlruns/

# Node
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
.dockerignore

# SQLite WAL/SHM sidecars. The v1 model_registry.db is no longer in the tree;
# its 5 permutation runs are preserved in history at 487b409.
*.db-wal
*.db-shm

# Coverage
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Agent tooling
.claude-flow/
.hive-mind/

# v2 venv
.venv-v2/

# Local data lake and trained artifacts — regenerable, and large
data/lake/
data/corp_actions.csv

# Node. Global on purpose: this was once scoped to a single directory, and when
# that directory was deleted the rule silently stopped matching — a routine
# `git add -A` then staged 7,000 dependency files.
node_modules/
*.tsbuildinfo
