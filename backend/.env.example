# ─────────────────────────────────────────────
#  INDICANT — Environment Variables Reference
#  Copy this to .env and fill in your values.
#  Never commit .env to git.
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
APP_ENV=development                        # development | production
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# ── API Security ──────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173      # comma-separated list for CORS
RATE_LIMIT_PER_IP=60                       # requests per minute per IP
RATE_LIMIT_GLOBAL=300                      # requests per minute total

# ── Data Sources ──────────────────────────────
# yfinance needs no API key — it uses Yahoo Finance directly.
# Optional: if you add Alpha Vantage or Tiingo later, put keys here.
# ALPHA_VANTAGE_API_KEY=your_key_here
# TIINGO_API_KEY=your_key_here

# ── MLflow ────────────────────────────────────
MLFLOW_TRACKING_URI=./experiments/mlruns   # local path or remote URI
MLFLOW_EXPERIMENT_NAME=indicant_v1

# ── Model Config ──────────────────────────────
CONFIDENCE_THRESHOLD=0.55                  # min confidence to emit BUY/SELL signal
LOOKBACK_YEARS=5                           # years of historical data to fetch
PREDICTION_HORIZON_MONTHS=6               # months ahead to predict

# ── Cache ─────────────────────────────────────
CACHE_DIR=./data/cache                     # where fetched data is cached locally
CACHE_TTL_HOURS=24                         # how long before re-fetching

# ── Universe ──────────────────────────────────
# Which indices to include in the NSE universe scan
NSE_INDICES=NIFTY50,NIFTY100,NIFTY500     # comma-separated
