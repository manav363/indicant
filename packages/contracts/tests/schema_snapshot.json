    "SymbolChange": {
      "additionalProperties": false,
      "description": "A symbol rename. Naive joins across a rename silently split one\ncompany's history into two, so this map is required, not optional.",
      "properties": {
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "isin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isin"
        },
        "new_symbol": {
          "title": "New Symbol",
          "type": "string"
        },
        "old_symbol": {
          "title": "Old Symbol",
          "type": "string"
        }
      },
      "required": [
        "old_symbol",
        "new_symbol",
        "effective_date"
      ],
      "title": "SymbolChange",
      "type": "object"
    },
    "SymbolMeta": {
      "$defs": {
        "ListingStatus": {
          "enum": [
            "listed",
            "delisted",
            "suspended"
          ],
          "title": "ListingStatus",
          "type": "string"
        },
        "Series": {
          "description": "NSE equity series. EQ is the rolling-settlement equity series we model.\n\nBE/BZ are trade-for-trade (surveillance) series; SM/ST are SME platform.\nWe keep them ingested but they are excluded from the eligible universe.\n\nNSE publishes far more series codes than these \u2014 real bhavcopy files carry\nGB (sovereign gold bonds), GS (government securities), N0-N9 (debentures),\nIV, YR, E1, BL and others, and the list grows without notice. Enumerating\nthem all is a losing game, so `coerce` folds anything unrecognised into\nOTHER rather than raising. A new instrument type appearing on the exchange\nis not a reason for the ingest to fall over; it is a reason to not model it.",
          "enum": [
            "EQ",
            "BE",
            "BZ",
            "SM",
            "ST",
            "OTHER"
          ],
          "title": "Series",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "What we know about a security independent of any single trading day.\n\n`delisted_on` being set is what makes the historical universe\nsurvivorship-bias-free: the symbol stays in history and stops being\neligible, rather than vanishing.",
      "properties": {
        "delisted_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delisted On"
        },
        "first_seen": {
          "format": "date",
          "title": "First Seen",
          "type": "string"
        },
        "isin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isin"
        },
        "last_seen": {
          "format": "date",
          "title": "Last Seen",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "series": {
          "$ref": "#/$defs/Series",
          "default": "EQ"
        },
        "status": {
          "$ref": "#/$defs/ListingStatus",
          "default": "listed"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "first_seen",
        "last_seen"
      ],
      "title": "SymbolMeta",
      "type": "object"
    },
    "TradingCalendar": {
      "additionalProperties": false,
      "description": "Which days the exchange actually traded. Required to tell 'no file\nbecause it was a holiday' apart from 'no file because ingestion broke'.",
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "trading_days": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Trading Days",
          "type": "array"
        }
      },
      "required": [
        "start",
        "end",
        "trading_days"
      ],
      "title": "TradingCalendar",
      "type": "object"
    },
    "UniverseSnapshot": {
      "additionalProperties": false,
      "description": "Point-in-time universe. `as_of` is load-bearing: asking for the\nuniverse without a date is how survivorship bias gets in.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "eligible_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Eligible Symbols",
          "type": "array"
        },
        "excluded": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "symbol -> human-readable reason it is not eligible",
          "title": "Excluded",
          "type": "object"
        },
        "index_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Name"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "as_of",
        "symbols",
        "eligible_symbols"
      ],
      "title": "UniverseSnapshot",
      "type": "object"
    }
  }
}
