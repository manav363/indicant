{
  "adjusted_extra_columns": [
    "adj_factor",
    "adj_close"
  ],
  "canonical_price_columns": [
    "date",
    "symbol",
    "series",
    "open",
    "high",
    "low",
    "close",
    "prev_close",
    "volume",
    "turnover",
    "trades",
    "delivery_qty",
    "delivery_pct",
    "isin"
  ],
  "lake_layout": {
    "ADJUSTED": {
      "dir": "adjusted",
      "file": "/L/adjusted/year=2020/adjusted_2020.parquet",
      "glob": "/L/adjusted/**/*.parquet"
    },
    "CALENDAR": {
      "dir": "calendar",
      "file": "/L/calendar/data.parquet",
      "glob": "/L/calendar/**/*.parquet"
    },
    "CORP_ACTIONS": {
      "dir": "corp_actions",
      "file": "/L/corp_actions/data.parquet",
      "glob": "/L/corp_actions/**/*.parquet"
    },
    "PRICES": {
      "dir": "prices",
      "file": "/L/prices/year=2020/prices_2020.parquet",
      "glob": "/L/prices/**/*.parquet"
    },
    "QUALITY_RUNS": {
      "dir": "quality/runs",
      "file": "/L/quality/runs/date=2020-06-15/data.parquet",
      "glob": "/L/quality/runs/**/*.parquet"
    },
    "QUALITY_SCORES": {
      "dir": "quality/scores",
      "file": "/L/quality/scores/data.parquet",
      "glob": "/L/quality/scores/**/*.parquet"
    },
    "QUARANTINE": {
      "dir": "quality/quarantine",
      "file": "/L/quality/quarantine/date=2020-06-15/data.parquet",
      "glob": "/L/quality/quarantine/**/*.parquet"
    },
    "SYMBOL_CHANGES": {
      "dir": "symbol_changes",
      "file": "/L/symbol_changes/data.parquet",
      "glob": "/L/symbol_changes/**/*.parquet"
    },
    "SYMBOL_META": {
      "dir": "symbol_meta",
      "file": "/L/symbol_meta/data.parquet",
      "glob": "/L/symbol_meta/**/*.parquet"
    },
    "UNIVERSE_PIT": {
      "dir": "universe_pit",
      "file": "/L/universe_pit/date=2020-06-15/data.parquet",
      "glob": "/L/universe_pit/**/*.parquet"
    }
  },
  "models": {
    "CalibrationBin": {
      "additionalProperties": false,
      "description": "One bucket of a reliability diagram. Perfect calibration is the\ndiagonal: mean_predicted == observed_rate in every bin.",
      "properties": {
        "bin_lower": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bin Lower",
          "type": "number"
        },
        "bin_upper": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bin Upper",
          "type": "number"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "mean_predicted": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mean Predicted",
          "type": "number"
        },
        "observed_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observed Rate",
          "type": "number"
        }
      },
      "required": [
        "bin_lower",
        "bin_upper",
        "mean_predicted",
        "observed_rate",
        "count"
      ],
      "title": "CalibrationBin",
      "type": "object"
    },
    "CorporateAction": {
      "$defs": {
        "CorporateActionType": {
          "enum": [
            "split",
            "bonus",
            "dividend",
            "rights",
            "merger",
            "demerger",
            "symbol_change",
            "delisting",
            "other"
          ],
          "title": "CorporateActionType",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "A corporate action with its price-adjustment ratio.\n\n`ratio` is the multiplicative factor applied to pre-event prices to make\nthem comparable with post-event prices. A 1:2 split has ratio 0.5 \u2014 every\nprice before the ex-date is halved.",
      "properties": {
        "action_type": {
          "$ref": "#/$defs/CorporateActionType"
        },
        "ex_date": {
          "format": "date",
          "title": "Ex Date",
          "type": "string"
        },
        "ratio": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "action_type",
        "ex_date"
      ],
      "title": "CorporateAction",
      "type": "object"
    },
    "EligibilityThresholds": {
      "additionalProperties": false,
      "description": "The bar a symbol must clear to be offered to a user.\n\nAnything below the bar is not a failure and not a fallback \u2014 it is\ncorrectly out of scope, and the UI says so in plain words.",
      "properties": {
        "min_history_days": {
          "default": 756,
          "minimum": 1,
          "title": "Min History Days",
          "type": "integer"
        },
        "min_median_turnover": {
          "default": 10000000.0,
          "minimum": 0,
          "title": "Min Median Turnover",
          "type": "number"
        },
        "min_recency": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Recency",
          "type": "number"
        },
        "min_score": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Score",
          "type": "number"
        }
      },
      "title": "EligibilityThresholds",
      "type": "object"
    },
    "ErrorEnvelope": {
      "$defs": {
        "ErrorCode": {
          "enum": [
            "symbol_not_found",
            "symbol_not_eligible",
            "invalid_request",
            "not_a_trading_day",
            "data_unavailable",
            "insufficient_history",
            "upstream_unavailable",
            "model_not_trained",
            "model_refused",
            "internal"
          ],
          "title": "ErrorCode",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "`user_message` is what a person reads; `message` is what an engineer\nreads. Keeping them separate stops internal detail leaking into the UI and\nstops the UI's phrasing being the only record of what broke.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "user_message": {
          "title": "User Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "user_message"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "ExplanationFact": {
      "$defs": {
        "Direction": {
          "enum": [
            "supports_up",
            "supports_down",
            "neutral"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "One SHAP contribution, ready for templating. No prose.\n\n`display_name` and `display_value` exist so the gateway never has to know\nthat `momentum_roc_6m` means \"6-month price change\" \u2014 that mapping lives\nwith the feature that defines it.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "display_value": {
          "title": "Display Value",
          "type": "string"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "shap": {
          "title": "Shap",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "display_name",
        "value",
        "display_value",
        "shap",
        "direction",
        "rank"
      ],
      "title": "ExplanationFact",
      "type": "object"
    },
    "LakePaths": {
      "additionalProperties": false,
      "description": "Resolves dataset paths under a lake root.\n\nDeliberately does no IO \u2014 it is a pure path calculator so both services\ncan agree on layout without either importing storage code.",
      "properties": {
        "root": {
          "format": "path",
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "title": "LakePaths",
      "type": "object"
    },
    "MarketRegimeResult": {
      "$defs": {
        "CompositeSignal": {
          "enum": [
            "risk_on",
            "risk_off",
            "neutral"
          ],
          "title": "CompositeSignal",
          "type": "string"
        },
        "PrimaryRegime": {
          "enum": [
            "bull",
            "bear",
            "ranging"
          ],
          "title": "PrimaryRegime",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "cache_ttl_minutes": {
          "minimum": 0,
          "title": "Cache Ttl Minutes",
          "type": "integer"
        },
        "composite_signal": {
          "$ref": "#/$defs/CompositeSignal"
        },
        "constituents_reporting": {
          "minimum": 0,
          "title": "Constituents Reporting",
          "type": "integer"
        },
        "majority_regime": {
          "$ref": "#/$defs/PrimaryRegime"
        },
        "median_adx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Adx"
        },
        "regime_distribution": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Regime Distribution",
          "type": "object"
        },
        "total_constituents": {
          "minimum": 0,
          "title": "Total Constituents",
          "type": "integer"
        }
      },
      "required": [
        "as_of",
        "majority_regime",
        "composite_signal",
        "regime_distribution",
        "constituents_reporting",
        "total_constituents",
        "cache_ttl_minutes"
      ],
      "title": "MarketRegimeResult",
      "type": "object"
    },
    "ModelCard": {
      "$defs": {
        "CalibrationBin": {
          "additionalProperties": false,
          "description": "One bucket of a reliability diagram. Perfect calibration is the\ndiagonal: mean_predicted == observed_rate in every bin.",
          "properties": {
            "bin_lower": {
              "maximum": 1,
              "minimum": 0,
              "title": "Bin Lower",
              "type": "number"
            },
            "bin_upper": {
              "maximum": 1,
              "minimum": 0,
              "title": "Bin Upper",
              "type": "number"
            },
            "count": {
              "minimum": 0,
              "title": "Count",
              "type": "integer"
            },
            "mean_predicted": {
              "maximum": 1,
              "minimum": 0,
              "title": "Mean Predicted",
              "type": "number"
            },
            "observed_rate": {
              "maximum": 1,
              "minimum": 0,
              "title": "Observed Rate",
              "type": "number"
            }
          },
          "required": [
            "bin_lower",
            "bin_upper",
            "mean_predicted",
            "observed_rate",
            "count"
          ],
          "title": "CalibrationBin",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "What the /model page renders. Every field here is evidence, not a claim.\n\n`permutation_p_value` and `deflated_sharpe` are present specifically so a\nnull result is a first-class, publishable output rather than something\nburied.",
      "properties": {
        "accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy"
        },
        "baseline_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Model"
        },
        "baseline_oos_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Oos Sharpe"
        },
        "brier_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brier Score"
        },
        "calibration": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CalibrationBin"
          },
          "title": "Calibration",
          "type": "array"
        },
        "cost_adjusted_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Adjusted Sharpe"
        },
        "cpcv_sharpe_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpcv Sharpe Mean"
        },
        "cpcv_sharpe_std": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpcv Sharpe Std"
        },
        "deflated_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deflated Sharpe"
        },
        "model_type": {
          "title": "Model Type",
          "type": "string"
        },
        "n_features": {
          "minimum": 0,
          "title": "N Features",
          "type": "integer"
        },
        "n_permutations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Permutations"
        },
        "n_train_samples": {
          "minimum": 0,
          "title": "N Train Samples",
          "type": "integer"
        },
        "oos_max_drawdown": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oos Max Drawdown"
        },
        "oos_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oos Sharpe"
        },
        "oos_sortino": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oos Sortino"
        },
        "permutation_p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permutation P Value"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "train_end": {
          "format": "date",
          "title": "Train End",
          "type": "string"
        },
        "train_start": {
          "format": "date",
          "title": "Train Start",
          "type": "string"
        },
        "trained_at": {
          "format": "date-time",
          "title": "Trained At",
          "type": "string"
        },
        "universe_size": {
          "minimum": 0,
          "title": "Universe Size",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "trained_at",
        "model_type",
        "n_train_samples",
        "n_features",
        "universe_size",
        "train_start",
        "train_end"
      ],
      "title": "ModelCard",
      "type": "object"
    },
    "OHLCVBar": {
      "$defs": {
        "Series": {
          "description": "NSE equity series. EQ is the rolling-settlement equity series we model.\n\nBE/BZ are trade-for-trade (surveillance) series; SM/ST are SME platform.\nWe keep them ingested but they are excluded from the eligible universe.\n\nNSE publishes far more series codes than these \u2014 real bhavcopy files carry\nGB (sovereign gold bonds), GS (government securities), N0-N9 (debentures),\nIV, YR, E1, BL and others, and the list grows without notice. Enumerating\nthem all is a losing game, so `coerce` folds anything unrecognised into\nOTHER rather than raising. A new instrument type appearing on the exchange\nis not a reason for the ingest to fall over; it is a reason to not model it.",
          "enum": [
            "EQ",
            "BE",
            "BZ",
            "SM",
            "ST",
            "OTHER"
          ],
          "title": "Series",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "One security, one trading day. Mirrors CANONICAL_PRICE_COLUMNS.\n\nValidity invariants (high >= low, high >= max(open, close), etc.) are\nenforced here so a malformed bar cannot be constructed in the first place.\nThe quality gate re-checks them at the dataframe level because bulk\ningestion never round-trips through this model.",
      "properties": {
        "close": {
          "exclusiveMinimum": 0,
          "title": "Close",
          "type": "number"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "delivery_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Pct"
        },
        "delivery_qty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Qty"
        },
        "high": {
          "exclusiveMinimum": 0,
          "title": "High",
          "type": "number"
        },
        "isin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isin"
        },
        "low": {
          "exclusiveMinimum": 0,
          "title": "Low",
          "type": "number"
        },
        "open": {
          "exclusiveMinimum": 0,
          "title": "Open",
          "type": "number"
        },
        "prev_close": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prev Close"
        },
        "series": {
          "$ref": "#/$defs/Series",
          "default": "EQ"
        },
        "symbol": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "trades": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trades"
        },
        "turnover": {
          "minimum": 0,
          "title": "Turnover",
          "type": "number"
        },
        "volume": {
          "minimum": 0,
          "title": "Volume",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "symbol",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "turnover"
      ],
      "title": "OHLCVBar",
      "type": "object"
    },
    "Prediction": {
      "$defs": {
        "Direction": {
          "enum": [
            "supports_up",
            "supports_down",
            "neutral"
          ],
          "title": "Direction",
          "type": "string"
        },
        "ExplanationFact": {
          "additionalProperties": false,
          "description": "One SHAP contribution, ready for templating. No prose.\n\n`display_name` and `display_value` exist so the gateway never has to know\nthat `momentum_roc_6m` means \"6-month price change\" \u2014 that mapping lives\nwith the feature that defines it.",
          "properties": {
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "display_name": {
              "title": "Display Name",
              "type": "string"
            },
            "display_value": {
              "title": "Display Value",
              "type": "string"
            },
            "feature": {
              "title": "Feature",
              "type": "string"
            },
            "rank": {
              "minimum": 1,
              "title": "Rank",
              "type": "integer"
            },
            "shap": {
              "title": "Shap",
              "type": "number"
            },
            "value": {
              "title": "Value",
              "type": "number"
            }
          },
          "required": [
            "feature",
            "display_name",
            "value",
            "display_value",
            "shap",
            "direction",
            "rank"
          ],
          "title": "ExplanationFact",
          "type": "object"
        },
        "PrimaryRegime": {
          "enum": [
            "bull",
            "bear",
            "ranging"
          ],
          "title": "PrimaryRegime",
          "type": "string"
        },
        "Signal": {
          "enum": [
            "BUY",
            "HOLD",
            "SELL"
          ],
          "title": "Signal",
          "type": "string"
        },
        "Strength": {
          "enum": [
            "strong",
            "moderate",
            "weak"
          ],
          "title": "Strength",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "A calibrated call plus everything needed to justify and size it.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "conviction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Meta-labeller P(this call is correct). None until L5 is trained.",
          "title": "Conviction"
        },
        "current_price": {
          "exclusiveMinimum": 0,
          "title": "Current Price",
          "type": "number"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExplanationFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "horizon_months": {
          "maximum": 24,
          "minimum": 1,
          "title": "Horizon Months",
          "type": "integer"
        },
        "model_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
