          "type": "string"
        },
        "Tier": {
          "description": "Rule tiers, ordered by how early they can reject.\n\nSTRUCTURAL failures kill the file. VALIDITY failures kill the row.\nEverything above that annotates rather than rejects, except where a\nthreshold escalates it.",
          "enum": [
            1,
