          "$ref": "#/$defs/CompositeSignal"
        },
        "drawdown_regime": {
          "title": "Drawdown Regime",
          "type": "string"
        },
        "primary_regime": {
          "$ref": "#/$defs/PrimaryRegime"
        },
        "regime_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Regime Score",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "trend_direction": {
          "title": "Trend Direction",
          "type": "string"
        },
        "volatility_regime": {
          "title": "Volatility Regime",
          "type": "string"
        }
      },
      "required": [
