        },
        "probability_up": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability Up",
          "type": "number"
        },
        "regime": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrimaryRegime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regime_aligned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime Aligned"
        },
        "signal": {
          "$ref": "#/$defs/Signal"
        },
        "strength": {
          "$ref": "#/$defs/Strength"
        },
        "suggested_position_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Suggested Position Pct",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "as_of",
        "horizon_months",
        "signal",
        "probability_up",
        "confidence",
        "strength",
        "current_price",
        "suggested_position_pct"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "QualityReport": {
      "$defs": {
        "RuleResult": {
          "additionalProperties": false,
          "description": "The outcome of one rule against one ingestion batch.\n\n`evidence` must be populated on failure. \"Rule X failed\" without actual\nvs expected is not actionable at 3am.",
          "properties": {
            "affected_rows": {
              "default": 0,
              "title": "Affected Rows",
              "type": "integer"
            },
            "affected_symbols": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Affected Symbols",
              "type": "array"
            },
            "evidence": {
              "additionalProperties": true,
              "title": "Evidence",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "passed": {
              "title": "Passed",
              "type": "boolean"
            },
            "rule_id": {
              "pattern": "^T[1-6]\\.[a-z_]+\\.[a-z_0-9]+$",
              "title": "Rule Id",
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/Severity"
            },
            "tier": {
              "$ref": "#/$defs/Tier"
            }
          },
          "required": [
            "rule_id",
            "tier",
            "severity",
            "passed",
            "message"
          ],
          "title": "RuleResult",
          "type": "object"
        },
        "Severity": {
          "enum": [
            "fatal",
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "Tier": {
          "description": "Rule tiers, ordered by how early they can reject.\n\nSTRUCTURAL failures kill the file. VALIDITY failures kill the row.\nEverything above that annotates rather than rejects, except where a\nthreshold escalates it.",
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "title": "Tier",
          "type": "integer"
        },
        "Verdict": {
          "enum": [
            "pass",
            "pass_with_warnings",
            "quarantined",
            "rejected"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Everything the gate concluded about one ingestion batch.",
      "properties": {
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/RuleResult"
          },
          "title": "Results",
          "type": "array"
        },
        "rows_accepted": {
          "minimum": 0,
          "title": "Rows Accepted",
          "type": "integer"
        },
        "rows_in": {
          "minimum": 0,
          "title": "Rows In",
          "type": "integer"
        },
        "rows_quarantined": {
          "minimum": 0,
          "title": "Rows Quarantined",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "run_id",
        "trade_date",
        "started_at",
        "finished_at",
        "verdict",
        "rows_in",
        "rows_accepted",
        "rows_quarantined",
        "results"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "QualityScore": {
      "additionalProperties": false,
      "description": "Per-symbol fitness. Drives universe eligibility.\n\nThe five components are deliberately separate rather than a single opaque\nnumber, so an exclusion can be explained to a user in one sentence.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "continuity_clean_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Continuity Clean Rate",
          "type": "number"
        },
        "history_completeness": {
          "maximum": 1,
          "minimum": 0,
          "title": "History Completeness",
          "type": "number"
        },
        "history_days": {
          "minimum": 0,
          "title": "History Days",
          "type": "integer"
        },
        "liquidity_adequacy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Liquidity Adequacy",
          "type": "number"
        },
        "median_turnover": {
          "minimum": 0,
          "title": "Median Turnover",
          "type": "number"
        },
        "recency": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recency",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "validity_clean_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Validity Clean Rate",
          "type": "number"
        }
      },
      "required": [
        "symbol",
        "as_of",
        "history_completeness",
        "validity_clean_rate",
        "continuity_clean_rate",
        "liquidity_adequacy",
        "recency",
        "history_days",
        "median_turnover"
      ],
      "title": "QualityScore",
      "type": "object"
    },
    "QuarantineRecord": {
      "additionalProperties": false,
      "description": "A held row and the rule that held it. Never deleted \u2014 fix the rule,\nthen replay.",
