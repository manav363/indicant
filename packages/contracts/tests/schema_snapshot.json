          "type": "string"
        }
      },
      "required": [
        "run_id",
        "trade_date",
        "symbol",
        "rule_id",
        "reason",
        "payload",
        "quarantined_at"
      ],
      "title": "QuarantineRecord",
      "type": "object"
    },
    "RegimeResult": {
